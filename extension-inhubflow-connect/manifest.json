{
  "manifest_version": 3,
  "name": "InHubFlow Connect — Vinculación LinkedIn 1-Clic",
  "short_name": "InHubFlow Connect",
  "version": "1.1.0",
  "description": "Extensión oficial de InHubFlow para vincular tu cuenta de LinkedIn con tu Dashboard en 1 solo clic de forma 100% segura y privada.",
  "permissions": [
    "cookies",
    "activeTab",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://linkedin.com/*",
    "http://localhost:3001/*",
    "http://localhost:3000/*",
    "https://*.inhubflow.com/*",
    "https://inhubflow.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3001/*",
        "http://localhost:3000/*",
        "https://*.inhubflow.com/*",
        "https://inhubflow.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "InHubFlow Connect",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
